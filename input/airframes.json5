{
    /*
    per model "airframe" of airplane:
    plot of x: air density (kg/m^3) to y: runway length needed
    
    formula: runwayLength = -(h / airDensity) * ln(1 - (g / airDensity))
    (see derived equation @ Dustins office)
    h, g are coefficients
    */
    
    models: [
        {
            model: "a330-200",
            mfg: "airbus",
            mtow: 242,
            h: 3.2,
            g: .8,
        },
    ],
}